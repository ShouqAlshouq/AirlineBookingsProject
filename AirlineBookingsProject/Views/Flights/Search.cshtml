@model List<Flight>

@{
    ViewData["Title"] = "Search Flights";
}

<h2>Search Flights</h2>

<form asp-action="Search" method="post">

    <div class="mb-3">
        <label>From City</label>
        <input type="text" name="fromCity" class="form-control"
               value="@ViewBag.LastFromCity" />
    </div>

    <div class="mb-3">
        <label>To City</label>
        <input type="text" name="toCity" class="form-control"
               value="@ViewBag.LastToCity" />
    </div>

    <div class="mb-3">
        <label>Date</label>
        <input type="date" name="date" class="form-control"
               value="@ViewBag.LastDate" />
    </div>

    <button type="submit" class="btn btn-primary">Search</button>

</form>

<hr />

<h3>Available Flights</h3>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Flight No</th>
                <th>From</th>
                <th>To</th>
                <th>Date</th>
                <th>Time</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model)
            {
                <tr>
                    <td>@flight.FlightNo</td>
                    <td>@flight.FromCity</td>
                    <td>@flight.ToCity</td>
                    <td>@flight.Date.ToShortDateString()</td>
                    <td>@flight.Time</td>
                    <td>@flight.Price</td>
                    <td>
                        <a asp-controller="Bookings"
                               asp-action="BookFlight"
                               asp-route-id="@flight.FlightId"
                               class="btn btn-success">
                            Book Now
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No flights found.</p>
}
